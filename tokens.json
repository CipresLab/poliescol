{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Tokens de marca Poliescol. Fuente: Manual de Marca 2024. Reglas completas en brand.md",
  "color": {
    "negro": {
      "$type": "color",
      "$value": "#000000",
      "rol": "primario",
      "rgb": [
        0,
        0,
        0
      ],
      "cmyk": [
        0,
        0,
        0,
        100
      ],
      "pantone": "Process Black C",
      "textoEncima": "#FFFFFF"
    },
    "verde": {
      "$type": "color",
      "$value": "#B5FF04",
      "rol": "complementario-1",
      "categoria": "automotriz",
      "rgb": [
        181,
        255,
        4
      ],
      "cmyk": [
        38,
        0,
        100,
        0
      ],
      "pantone": "389 C",
      "textoEncima": "#000000",
      "significado": "autenticidad, creatividad"
    },
    "aqua": {
      "$type": "color",
      "$value": "#20F9F5",
      "rol": "complementario-2",
      "categoria": "arquitectonico",
      "rgb": [
        32,
        249,
        245
      ],
      "cmyk": [
        58,
        0,
        18,
        0
      ],
      "pantone": "319 C",
      "textoEncima": "#000000",
      "significado": "armonía, confianza, comunicación clara, lo celestial"
    },
    "violeta": {
      "$type": "color",
      "$value": "#741DEC",
      "rol": "complementario-3",
      "categoria": "metalmecanico",
      "rgb": [
        116,
        29,
        236
      ],
      "cmyk": [
        80,
        80,
        0,
        0
      ],
      "pantone": "814 C",
      "textoEncima": "#FFFFFF",
      "significado": "sabiduría, espiritualidad"
    },
    "naranja": {
      "$type": "color",
      "$value": "#FF621D",
      "rol": "complementario-4",
      "categoria": "madera",
      "rgb": [
        255,
        98,
        29
      ],
      "cmyk": [
        0,
        72,
        87,
        0
      ],
      "pantone": "1585 C",
      "textoEncima": "#000000",
      "significado": "entusiasmo, fuego, pasión"
    },
    "blanco": {
      "$type": "color",
      "$value": "#FFFFFF",
      "rol": "neutro"
    },
    "grisClaro": {
      "$type": "color",
      "$value": "#EDEDED",
      "rol": "neutro-fondo-claro",
      "textoEncima": "#000000"
    },
    "grisMedio": {
      "$type": "color",
      "$value": "#5F5F5F",
      "rol": "neutro-numerales"
    }
  },
  "colorPorMensaje": {
    "$regla": "La IA (y cualquier persona) no puede elegir libremente colores de la paleta: debe usar exactamente la combinación asignada a la categoría de la comunicación. Si la categoría no está en la tabla, se usa la de Comunicado institucional.",
    "comunicado": {
      "categoria": "Comunicado institucional",
      "fondo": "#000000",
      "texto": "#FFFFFF",
      "acento": "#20F9F5",
      "complementos": "Panel gris claro #EDEDED con texto negro; ventana de luz pequeña.",
      "prohibido": "Verde, violeta o naranja como acento."
    },
    "bienvenida": {
      "categoria": "Bienvenida",
      "fondo": "#20F9F5",
      "texto": "#000000",
      "acento": "#000000",
      "complementos": "Foto de la persona.",
      "prohibido": "Cualquier otro complementario."
    },
    "cumpleanos": {
      "categoria": "Cumpleaños",
      "fondo": "#000000",
      "texto": "#FFFFFF",
      "acento": "#FF621D",
      "complementos": "Ventana de luz grande rotada −8°; nombre en naranja.",
      "prohibido": "Fondos de color; otro color para el nombre."
    },
    "reconocimiento": {
      "categoria": "Reconocimiento",
      "fondo": "#B5FF04",
      "texto": "#000000",
      "acento": "#B5FF04",
      "complementos": "Panel negro #000000 con texto blanco.",
      "prohibido": "Aqua, violeta o naranja."
    },
    "formacion": {
      "categoria": "Formación y eventos",
      "fondo": "#741DEC",
      "texto": "#FFFFFF",
      "acento": "#B5FF04",
      "complementos": "Bloque de fecha negro; panel de datos gris claro con texto negro.",
      "prohibido": "Aqua o naranja."
    },
    "bienestar": {
      "categoria": "Bienestar, salud y seguridad",
      "fondo": "#EDEDED",
      "texto": "#000000",
      "acento": "#741DEC",
      "complementos": "Pasos numerados en verde, aqua y naranja (en ese orden).",
      "prohibido": "Fondo negro o de color."
    },
    "condolencia": {
      "categoria": "Condolencias y duelo",
      "fondo": "#000000",
      "texto": "#FFFFFF",
      "acento": "—",
      "complementos": "Grises #BDBDBD y #8A8A8A para textos secundarios.",
      "prohibido": "Cualquier color complementario, ventana de luz, emojis."
    }
  },
  "font": {
    "titular": {
      "$type": "fontFamily",
      "$value": [
        "Claris Sans",
        "Outfit",
        "sans-serif"
      ],
      "archivo": "assets/fonts/ClarisSans.ttf",
      "licencia": "SIL OFL",
      "peso": 600,
      "transform": "lowercase",
      "interlineado": 0.98,
      "tracking": "-0.015em"
    },
    "copy": {
      "$type": "fontFamily",
      "$value": [
        "Roboto",
        "sans-serif"
      ],
      "peso": 900,
      "archivo": "descargas/poliescol-fuente-roboto.zip",
      "licencia": "SIL OFL",
      "uso": "subtítulos, etiquetas y destacados"
    },
    "texto": {
      "$type": "fontFamily",
      "$value": [
        "Roboto",
        "sans-serif"
      ],
      "peso": 400,
      "interlineado": 1.35,
      "archivo": "descargas/poliescol-fuente-roboto.zip",
      "licencia": "SIL OFL",
      "uso": "cuerpo de texto y bajadas"
    },
    "alternativa": {
      "titular": "Outfit 600",
      "texto": "Arial / Arial Black",
      "regla": "solo si la herramienta no permite instalar las fuentes oficiales"
    }
  },
  "escalaEnLienzo1080": {
    "etiqueta": {
      "min": 20,
      "max": 26,
      "unidad": "px",
      "transform": "uppercase",
      "tracking": "0.2em"
    },
    "numeral": {
      "min": 56,
      "max": 110,
      "unidad": "px",
      "formato": "01."
    },
    "titular": {
      "min": 90,
      "max": 150,
      "unidad": "px",
      "maxPalabras": 7
    },
    "bajada": {
      "min": 32,
      "max": 38,
      "unidad": "px",
      "maxPalabras": 25
    },
    "datos": {
      "min": 28,
      "max": 32,
      "unidad": "px"
    }
  },
  "forma": {
    "radioBase": {
      "$type": "dimension",
      "$value": "24px"
    },
    "radioMayor": {
      "$type": "dimension",
      "$value": "96px",
      "regla": "una sola esquina por contenedor"
    },
    "margenLienzo1080": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "ventanaDeLuz": {
    "orden": [
      "verde",
      "aqua",
      "violeta",
      "naranja"
    ],
    "altoSobreAncho": 1.47,
    "filaInferiorSobreSuperior": 2.2,
    "separacionSobreAncho": 0.06,
    "radioSobreAncho": 0.09,
    "rotacionMaxGrados": 10,
    "maxPorPieza": 1
  },
  "logo": {
    "$regla": "Usar solo los archivos oficiales. Prohibido recrear, redibujar o generar el logo con IA.",
    "principal": {
      "fondoOscuro": "descargas/poliescol-logo-principal-blanco.svg",
      "fondoOscuroPNG": "descargas/poliescol-logo-principal-blanco-transparente.png",
      "fondoClaro": "descargas/poliescol-logo-principal-negro.svg",
      "fondoClaroPNG": "descargas/poliescol-logo-principal-negro-transparente.png"
    },
    "horizontal": {
      "fondoOscuro": "descargas/poliescol-logo-horizontal-blanco.svg",
      "fondoOscuroPNG": "descargas/poliescol-logo-horizontal-blanco-transparente.png",
      "fondoClaro": "descargas/poliescol-logo-horizontal-negro.svg",
      "fondoClaroPNG": "descargas/poliescol-logo-horizontal-negro-transparente.png"
    },
    "icono": "descargas/poliescol-icono.svg",
    "iconoPNG": "descargas/poliescol-icono-transparente.png",
    "vectorialPDF": "descargas/poliescol-logos-vectorial.pdf",
    "minimoDigitalPx": 50,
    "minimoImpresoMm": 20,
    "reservaImpresa": {
      "arribaAbajoCm": 1,
      "ladosCm": 1.5
    },
    "reservaDigital": {
      "arribaAbajo": "10% del ancho",
      "lados": "15% del ancho"
    },
    "posicion": "abajo-izquierda"
  },
  "formatos": {
    "post": {
      "ancho": 1080,
      "alto": 1350
    },
    "historia": {
      "ancho": 1080,
      "alto": 1920,
      "zonaSeguraVerticalPx": 250
    },
    "correo": {
      "ancho": 600,
      "alto": 200
    },
    "videollamada": {
      "ancho": 1920,
      "alto": 1080
    },
    "cartelera": {
      "papel": "carta",
      "margenCm": 2
    }
  }
}